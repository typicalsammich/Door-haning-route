function esc(s){return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
var LSKEY='vaa-routes-progress-v1';
var P={A:{},B:{}};
try{var raw=localStorage.getItem(LSKEY);if(raw)P=JSON.parse(raw);}catch(e){P={A:{},B:{}};}
function save(){try{localStorage.setItem(LSKEY,JSON.stringify(P));}catch(e){}}
var counts={A:0,B:0};
['A','B'].forEach(function(r){D.routes[r].forEach(function(c){counts[r]+=c.n;});});
var total=counts.A+counts.B;

var map=L.map('map').setView([33.68,-117.15],10);
L.tileLayer('https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}',{maxZoom:19,attribution:'&copy; <a href="https://www.esri.com/">Esri</a> & contributors'}).addTo(map);
var colors={A:'#1f6feb',B:'#e8590c'};
var groups={}, markers={};
['A','B'].forEach(function(r){
  groups[r]=L.layerGroup().addTo(map);
  markers[r]=[];
  var pts=[];
  D.routes[r].forEach(function(c,i){
    pts.push([c.lat,c.lon]);
    var rows=c.biz.map(function(b){
      var done=P[r][b[0]];
      return '<tr><td class="sn">'+b[0]+'</td><td>'+(done?'&#10003; ':'')+'<b>'+esc(b[1])+'</b><br><span style="color:#555">'+esc(b[2])+' - '+esc(b[3])+'</span></td></tr>';
    }).join('');
    var popup='<b>Route '+r+' - cluster '+(i+1)+' of '+D.routes[r].length+'</b><br><b>'+esc(c.name)+'</b> ('+c.n+' businesses, starts at stop #'+c.first+')<div class="popup-biz"><table>'+rows+'</table></div>';
    var mk=L.circleMarker([c.lat,c.lon],{radius:11,color:'#fff',weight:2,fillColor:colors[r],fillOpacity:1}).addTo(groups[r]);
    mk.bindPopup(popup,{maxWidth:340});
    var tip=L.tooltip({permanent:true,direction:'center',className:'num-label',offset:[0,0]}).setContent(String(i+1));
    mk.bindTooltip(tip);
    markers[r].push({mk:mk,tip:tip,cluster:c,idx:i});
  });
  L.polyline(pts,{color:colors[r],weight:2.5,opacity:.55,dashArray:'6 6'}).addTo(groups[r]);
});
L.marker([D.start.lat,D.start.lon],{title:'Start'}).addTo(map).bindPopup('<b>Start point</b><br>'+esc(D.start.address));
var all=D.routes.A.concat(D.routes.B);
var bounds=L.latLngBounds(all.map(function(c){return [c.lat,c.lon];}));
bounds.extend([D.start.lat,D.start.lon]);
map.fitBounds(bounds.pad(0.08));
L.control.layers(null,{'Route A':groups.A,'Route B':groups.B},{collapsed:false}).addTo(map);

function clusterDone(r,c){var d=0;c.biz.forEach(function(b){if(P[r][b[0]])d++;});return d;}
function refreshMarkers(){
  ['A','B'].forEach(function(r){
    markers[r].forEach(function(m){
      var d=clusterDone(r,m.cluster), doneAll=d===m.cluster.n;
      m.mk.setStyle({fillColor:doneAll?'#2f9e44':colors[r]});
      m.tip.setContent(doneAll?'\u2713 '+(m.idx+1):(m.idx+1)+(d>0?' ('+d+'/'+m.cluster.n+')':''));
      var rows=m.cluster.biz.map(function(b){
        return '<tr><td class="sn">'+b[0]+'</td><td>'+(P[r][b[0]]?'\u2713 ':'')+'<b>'+esc(b[1])+'</b><br><span style="color:#555">'+esc(b[2])+' - '+esc(b[3])+'</span></td></tr>';
      }).join('');
      m.mk.setPopupContent('<b>Route '+r+' - cluster '+(m.idx+1)+' of '+D.routes[r].length+'</b><br><b>'+esc(m.cluster.name)+'</b> ('+m.cluster.n+' businesses, starts at stop #'+m.cluster.first+')<div class="popup-biz"><table>'+rows+'</table></div>');
    });
  });
}
function refreshBars(){
  var done=0;
  ['A','B'].forEach(function(r){Object.keys(P[r]).forEach(function(k){if(P[r][k])done++;});});
  document.getElementById('pbar').style.width=(total?done/total*100:0)+'%';
  document.getElementById('progtxt').textContent=done+' / '+total+' done';
  var r=curRoute, rd=0;
  Object.keys(P[r]).forEach(function(k){if(P[r][k])rd++;});
  document.getElementById('rbar').style.width=(counts[r]?rd/counts[r]*100:0)+'%';
  document.getElementById('routetxt').textContent='Route '+r+': '+rd+' / '+counts[r]+' done';
}
var curRoute='A';
function renderList(){
  var q=document.getElementById('search').value.trim().toLowerCase();
  var list=document.getElementById('list');list.innerHTML='';
  D.routes[curRoute].forEach(function(c,i){
    var d=clusterDone(curRoute,c);
    var bizRows=c.biz.filter(function(b){
      return !q||b[1].toLowerCase().indexOf(q)>-1||b[2].toLowerCase().indexOf(q)>-1||b[3].toLowerCase().indexOf(q)>-1;
    });
    if(q&&!bizRows.length)return;
    var det=document.createElement('details');det.className='cluster';
    var sum=document.createElement('summary');
    sum.innerHTML='<span class="cnum'+(d===c.n?' done':'')+'">'+(d===c.n?'\u2713':(i+1))+'</span><span>'+esc(c.name)+'</span><span class="cmeta">'+d+'/'+c.n+'</span>';
    det.appendChild(sum);
    det.addEventListener('toggle',function(){if(det.open)map.flyTo([c.lat,c.lon],13,{duration:0.8});});
    bizRows.forEach(function(b){
      var lab=document.createElement('label');lab.className='biz'+(P[curRoute][b[0]]?' done':'');
      lab.innerHTML='<input type="checkbox"'+(P[curRoute][b[0]]?' checked':'')+'><span class="sn">'+b[0]+'</span><span><span class="bname"><b>'+esc(b[1])+'</b></span><br><span class="addr">'+esc(b[2])+' \u00b7 '+esc(b[3])+'</span></span>';
      var cb=lab.querySelector('input');
      cb.addEventListener('change',function(){
        P[curRoute][b[0]]=cb.checked;
        if(!cb.checked)delete P[curRoute][b[0]];
        lab.classList.toggle('done',cb.checked);
        save();refreshMarkers();refreshBars();
        var dd=clusterDone(curRoute,c);
        sum.querySelector('.cmeta').textContent=dd+'/'+c.n;
        var cn=sum.querySelector('.cnum');
        cn.classList.toggle('done',dd===c.n);
        cn.textContent=dd===c.n?'\u2713':(i+1);
      });
      det.appendChild(lab);
    });
    list.appendChild(det);
  });
  refreshBars();
}
document.getElementById('tabA').addEventListener('click',function(){curRoute='A';this.classList.add('active');document.getElementById('tabB').classList.remove('active');document.getElementById('search').value='';renderList();});
document.getElementById('tabB').addEventListener('click',function(){curRoute='B';this.classList.add('active');document.getElementById('tabA').classList.remove('active');document.getElementById('search').value='';renderList();});
document.getElementById('search').addEventListener('input',renderList);
document.getElementById('sideToggle').addEventListener('click',function(){document.getElementById('side').classList.toggle('open');});
document.getElementById('btnReset').addEventListener('click',function(){
  if(confirm('Clear all checkmarks for both routes?')){P={A:{},B:{}};save();refreshMarkers();renderList();}
});
document.getElementById('btnExport').addEventListener('click',function(){
  var blob=new Blob([JSON.stringify(P)],{type:'application/json'});
  var a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='vaa-routes-progress.json';a.click();
});
document.getElementById('btnImport').addEventListener('click',function(){document.getElementById('fileImp').click();});
document.getElementById('fileImp').addEventListener('change',function(e){
  var f=e.target.files[0];if(!f)return;
  var rd=new FileReader();
  rd.onload=function(){try{var p=JSON.parse(rd.result);if(p.A&&p.B){P=p;save();refreshMarkers();renderList();alert('Progress imported.');}else alert('That file does not look like a progress export.');}catch(err){alert('Could not read that file.');}};
  rd.readAsText(f);e.target.value='';
});
refreshMarkers();renderList();
